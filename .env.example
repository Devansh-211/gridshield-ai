# GridShield AI — Environment Configuration Example
# Copy to .env for local development

# -----------------------------------------------------------------------------
# App & Runtime Settings
# -----------------------------------------------------------------------------
APP_ENV=development
APP_ACCESS_CODE=
ALLOW_EPHEMERAL_DB=false

# -----------------------------------------------------------------------------
# Database Configuration (Supabase Postgres in Prod / SQLite in Local Dev)
# -----------------------------------------------------------------------------
# Local Dev (SQLite):
DATABASE_URL=sqlite:///./data/gridshield.db
DATABASE_URL_MIGRATIONS=sqlite:///./data/gridshield.db
DB_SCHEMA=gridshield

# Production (Supabase Postgres via Supavisor Transaction Pooler, Port 6543):
# DATABASE_URL=postgresql://gridshield_app.projectref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL_MIGRATIONS=postgresql://postgres.projectref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

DB_SIZE_GUARD_MB=350

# -----------------------------------------------------------------------------
# Session & Rate Limiting Controls
# -----------------------------------------------------------------------------
MAX_STORED_RUNS_PER_VISITOR=3
VISITOR_TTL_HOURS=24
MAX_STEPS_PER_RUN=1800
MAX_STEPS_PER_ADVANCE=10
ADVANCE_TIME_BUDGET_S=20

RATE_LIMIT_CREATE_SESSION=10
RATE_LIMIT_ADVANCE=120
RATE_LIMIT_INJECT=30
RATE_LIMIT_ANALYST=15
RATE_LIMIT_DEMO=10

# -----------------------------------------------------------------------------
# LLM AI Analyst (Gemini)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_DAILY_CALL_CAP=100
LLM_VISITOR_DAILY_CAP=20

# -----------------------------------------------------------------------------
# Maintenance & Vercel Cron
# -----------------------------------------------------------------------------
CRON_SECRET=dev-cron-secret-12345
